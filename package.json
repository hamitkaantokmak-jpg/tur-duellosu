{
  "name": "tur-duellosu",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "serve": "node scripts/serve.cjs 4173",
    "test:unit": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "assets:build": "blender -b --threads 2 --python art/blender/build_v7.py && node scripts/optimize-v4.mjs --cars-only",
    "assets:build:v3": "node scripts/prepare-track.cjs && node scripts/prepare-mexico-v3.mjs && python3 scripts/prepare-boundaries.py && node scripts/build-car.mjs",
    "assets:build:v4": "blender -b --threads 2 --python art/blender/build_v4.py && node scripts/optimize-v4.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@playwright/test": "1.56.1",
    "meshoptimizer": "0.25.0",
    "three": "0.180.0"
  }
}
